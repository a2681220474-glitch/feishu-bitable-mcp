# Feishu enterprise self-built app credentials. Keep real values only in .env.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Default: local HTTP, read only. Use --transport stdio for local MCP clients.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# In Bearer mode, non-loopback binding requires a random value of at least 32 characters.
# This bearer credential is for MCP clients; it is NOT a Feishu token or OAuth server.
MCP_AUTH_TOKEN=

# Recommended ChatGPT web login: GitHub OAuth app + explicit numeric user allowlist.
# Set these and MCP_PUBLIC_URL. Leave MCP_AUTH_TOKEN and MCP_OAUTH_* empty.
# Writes must remain disabled. See docs/github-login.md.
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
MCP_GITHUB_ALLOWED_USER_IDS=

# ChatGPT web alternative: external OAuth provider (RS256 JWT access tokens).
# Configure all three and leave MCP_AUTH_TOKEN empty; writes remain disabled.
# The issuer must support ChatGPT client registration + authorization-code/PKCE.
# Restrict sign-in to your approved users at the identity provider.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_PUBLIC_URL=

# Optional exact URLs restricting all reads. Empty means all app-authorized tables.
# Multiple URLs separated by commas; example identifiers in README are fictional.
FEISHU_READ_TABLE_URLS=

# Disabled by default. To enable create_record, all three controls are required:
# FEISHU_ENABLE_WRITES=true, MCP_AUTH_TOKEN, and exact FEISHU_WRITE_TABLE_URLS.
FEISHU_ENABLE_WRITES=false
FEISHU_WRITE_TABLE_URLS=
