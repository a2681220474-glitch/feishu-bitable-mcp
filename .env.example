# Run feishu-bitable-mcp --setup to create a private .env.
# Each deployer uses their own Feishu enterprise self-built app.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# user: sign in to Feishu through ChatGPT, read as that person.
# app: legacy application identity, with app resource authorization.
FEISHU_AUTH_MODE=user

# Your public HTTPS /mcp endpoint. Forward the entire service.
# Add https://<your-host>/auth/callback to the Feishu app redirect allowlist.
MCP_PUBLIC_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Enable only the approved read scopes you actually need.
FEISHU_USER_SCOPES=bitable:app:readonly docx:document:readonly sheets:spreadsheet:readonly drive:drive:readonly wiki:wiki:readonly offline_access

# Optional exact resource restrictions, comma separated.
FEISHU_READ_TABLE_URLS=
FEISHU_READ_RESOURCE_URLS=

# User mode is read-only. Advanced app-mode options are in README.
FEISHU_ENABLE_WRITES=false
FEISHU_WRITE_TABLE_URLS=
MCP_AUTH_TOKEN=
