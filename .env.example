# Run feishu-bitable-mcp --setup to create a private .env.
# Each deployer uses their own Feishu enterprise self-built app.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# user: sign in to Feishu through ChatGPT, read as that person.
# app: legacy application identity, with app resource authorization.
FEISHU_AUTH_MODE=user

# Your public HTTPS /mcp endpoint. Forward the entire service.
# Add https://<your-host>/auth/callback to the Feishu app redirect allowlist.
MCP_PUBLIC_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Keep true normally. If a proxy returns reserved/fake DNS addresses, false uses
# Dynamic Client Registration instead; keep SDK SSRF, PKCE and consent checks intact.
MCP_OAUTH_ENABLE_CIMD=true

# Enable only the approved read scopes you actually need.
# Granular-scope applications can use the alternative in docs/user-access.md.
FEISHU_USER_SCOPES=bitable:app:readonly docx:document:readonly sheets:spreadsheet:readonly drive:drive:readonly wiki:wiki:readonly offline_access

# Optional exact resource restrictions, comma separated.
FEISHU_READ_TABLE_URLS=
FEISHU_READ_RESOURCE_URLS=

# Legacy app-only single-record creation. Keep false with the preview/commit mode.
FEISHU_ENABLE_WRITES=false
FEISHU_WRITE_TABLE_URLS=
MCP_AUTH_TOKEN=

# Optional development preview/commit mode (default off; no delete operations).
# Add only required, actually granted write scopes to FEISHU_USER_SCOPES.
# Operation -> exact resource URLs; see docs/changes.md. Never include real IDs in Git.
FEISHU_ENABLE_CHANGES=false
FEISHU_CHANGE_ALLOWLIST={}
FEISHU_CHANGE_LEDGER=.state/operations.sqlite3
# Experimental same-token XLSX overwrite: operator-selected, authorized test folder only.
FEISHU_EXCEL_OVERWRITE_FOLDER_URL=
